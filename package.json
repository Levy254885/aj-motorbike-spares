{
  "name": "aj-motorbike-spares",
  "version": "1.0.0",
  "description": "Offline desktop POS and inventory system for AJ Motorbike Spares. Electron, React, TypeScript, SQLite.",
  "main": "dist/main/main.js",
  "author": "AJ Motorbike Spares",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 tsx scripts/start-electron.ts\"",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "postinstall": "electron-builder install-app-deps",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run icons && npm run build && electron-builder --win",
    "dist:dir": "npm run icons && npm run build && electron-builder --win --dir",
    "dist:linux": "npm run icons && npm run build && electron-builder --linux",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.4",
    "electron-log": "^5.4.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ajmotorbikespares.desktop",
    "productName": "AJ Motorbike Spares",
    "copyright": "Copyright © AJ Motorbike Spares",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "npmRebuild": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AJ Motorbike Spares",
      "deleteAppDataOnUninstall": false,
      "artifactName": "AJ-Motorbike-Spares-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AJ-Motorbike-Spares-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "AJ-Motorbike-Spares-${version}.${ext}"
    }
  }
}
