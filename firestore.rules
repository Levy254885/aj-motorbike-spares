rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    function isAdmin() {
      return isSignedIn() && userExists() && role() == 'ADMIN';
    }
    function isManager() {
      return isSignedIn() && userExists() && (role() == 'MANAGER' || role() == 'ADMIN');
    }
    function isCashier() {
      return isSignedIn() && userExists() && (role() == 'CASHIER' || role() == 'ADMIN' || role() == 'MANAGER');
    }
    function isStorekeeper() {
      return isSignedIn() && userExists() && (role() == 'STOREKEEPER' || role() == 'ADMIN' || role() == 'MANAGER');
    }

    // Auto-create own profile on first login is allowed
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
      allow list: if isSignedIn();
    }

    match /products/{id} {
      allow read: if isSignedIn();
      allow create, update: if isManager() || isStorekeeper();
      allow delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /suppliers/{id} {
      allow read: if isSignedIn();
      allow write: if isManager() || isStorekeeper();
    }
    match /customers/{id} {
      allow read: if isSignedIn();
      allow write: if isCashier();
    }
    match /sales/{id} {
      allow read: if isCashier();
      allow create: if isCashier();
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /purchases/{id} {
      allow read: if isStorekeeper() || isManager();
      allow write: if isStorekeeper() || isManager();
    }
    match /stockMovements/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /expenses/{id} {
      allow read, write: if isAdmin() || isManager();
    }
    match /notifications/{id} {
      allow read, write: if isSignedIn();
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /counters/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
